<?xml version="1.0" encoding="UTF-8"?>

<!-- The editor snapshot test (PLAN.md §7 row 5, Tests/run_snapshot.sh): a console app that
     compiles Source/plugin and Source/ui with the plug-in's defines (SnapshotDefines.h). -->
<JUCERPROJECT id="CdsmSn" name="ChordismSnapshot" projectType="consoleapp" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1" version="0.1.0"
              cppLanguageStandard="17">
  <MAINGROUP id="snMain" name="ChordismSnapshot">
    <GROUP id="snSrc" name="Source">
        <FILE id="snF000" name="Main.cpp" compile="1" resource="0" file="Main.cpp"/>
        <FILE id="snF001" name="ChordismProcessor.cpp" compile="1" resource="0" file="../../Source/plugin/ChordismProcessor.cpp"/>
        <FILE id="snF002" name="Parameters.cpp" compile="1" resource="0" file="../../Source/plugin/Parameters.cpp"/>
        <FILE id="snF003" name="VirtualMidiOut.cpp" compile="1" resource="0" file="../../Source/plugin/VirtualMidiOut.cpp"/>
        <FILE id="snF004" name="ChordEditorState.cpp" compile="1" resource="0" file="../../Source/plugin/ChordEditorState.cpp"/>
        <FILE id="snF005" name="ChordismEditor.cpp" compile="1" resource="0" file="../../Source/ui/ChordismEditor.cpp"/>
        <FILE id="snF006" name="Theme.cpp" compile="1" resource="0" file="../../Source/ui/Theme.cpp"/>
        <FILE id="snF007" name="ParamControl.cpp" compile="1" resource="0" file="../../Source/ui/ParamControl.cpp"/>
        <FILE id="snF008" name="Keyboards.cpp" compile="1" resource="0" file="../../Source/ui/Keyboards.cpp"/>
        <FILE id="snF009" name="ChordEditorPanel.cpp" compile="1" resource="0" file="../../Source/ui/ChordEditorPanel.cpp"/>
        <FILE id="snF010" name="Panels.cpp" compile="1" resource="0" file="../../Source/ui/Panels.cpp"/>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors_headless" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_utils" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>
  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1" JUCE_WEB_BROWSER="0" JUCE_USE_CURL="0"/>
  <EXPORTFORMATS>
    <XCODE_MAC targetFolder="Builds/MacOSX" extraFrameworks="CoreMIDI" extraCompilerFlags="-include $(SRCROOT)/../../SnapshotDefines.h">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug" targetName="ChordismSnapshot" macOSDeploymentTarget="12.0" osxArchitecture="Standard"/>
        <CONFIGURATION isDebug="0" name="Release" targetName="ChordismSnapshot" macOSDeploymentTarget="12.0" osxArchitecture="Standard"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors_headless" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_core" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_events" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="/Users/alistairrutherford/Development/JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="/Users/alistairrutherford/Development/JUCE/modules"/>
      </MODULEPATHS>
    </XCODE_MAC>
  </EXPORTFORMATS>
</JUCERPROJECT>
